          src="https://logo.clearbit.com/saint-gobain.com"
          alt="Saint-Gobain"
          class="h-9 max-w-[130px] object-contain brightness-0 invert"
        />
      </div>

      <div
        class="flex min-w-[180px] items-center justify-center border-r border-[rgba(201,169,110,0.12)] px-12 py-5 opacity-45 transition hover:opacity-100"

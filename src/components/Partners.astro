---
import SectionHead from "./shared/SectionHead.astro";
import MarqueeImage from "./shared/MarqueeImage.astro";
const marqueeImages = [
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_blum.svg`,
    bgSize: "76%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_asianpaints2.svg`,
    bgSize: "50%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_hafele.svg`,
    bgSize: "90%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_centuryply.svg`,
    bgSize: "76%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_philips.svg`,
    bgSize: "85%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_havells.svg`,
    bgSize: "60%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_greenply.svg`,
    bgSize: "70%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_fevicol.svg`,
    bgSize: "60%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_hettich.svg`,
    bgSize: "90%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_tesa.svg`,
    bgSize: "86%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_finolex.svg`,
    bgSize: "86%",
  },
  {
    imgUrl: `${import.meta.env.BASE_URL}images/ptnr_ebco.svg`,
    bgSize: "73%",
  },
];
---

<section id="partners" class="px-[5vw] py-20">
  <SectionHead
    tag="Trusted Collaborators"
    title={[
      { text: "Our", highlight: false },
      { text: "Partners", highlight: true },
    ]}
    description="We collaborate with the world's most distinguished material suppliers, architects, and design houses to deliver nothing short of the finest."
  />

  <!-- Logo Marquee -->
  <div class="reveal relative mt-14 overflow-hidden">
    <!-- Left Fade -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-[120px] bg-[linear-gradient(to_right,#1a1710,transparent)]"
    >
    </div>

    <!-- Right Fade -->
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-[120px] bg-[linear-gradient(to_left,#1a1710,transparent)]"
    >
    </div>

    <!-- Track -->
    <div
      id="partnersTrack"
      class="flex w-max animate-[partnersScroll_28s_linear_infinite] items-center hover:[animation-play-state:paused]"
    >
      <!-- SET 1 -->
      {
        marqueeImages.map((item) => (
          <MarqueeImage imgUrl={item.imgUrl} bgSize={item.bgSize} />
        ))
      }
      {
        marqueeImages.map((item) => (
          <MarqueeImage imgUrl={item.imgUrl} bgSize={item.bgSize} />
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes partnersScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

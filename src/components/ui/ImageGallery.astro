---
import padZero from "../../lib/padZero";

export interface ImageCardProps {
  title?: string;
  description?: string;
  imagePath: string;
}

interface Props {
  data: ImageCardProps[];
  galleryId: string;
  allowHover?: boolean;
  allowPreview?: boolean;
  allowViewMore?: boolean;
  limit?: number;
}

const {
  data,
  allowHover,
  allowPreview = true,
  limit = 6,
  allowViewMore = true,
  galleryId,
} = Astro.props;
let len = data.length;
let showViewMore = false;

if (typeof limit == "number" && limit <= len) {
  len = limit;
}

if (data.length > limit && allowViewMore && allowPreview) {
  showViewMore = true;
}
---

<div
  id={`${galleryId}-image-gallery`}
  class="grid grid-cols-6 gap-1 max-[900px]:grid-cols-2"
>
  {
    data
      .slice(0, limit ?? len)
      .map(({ title, description, imagePath }, idx) => {
        let isSpan3 = false;

        if (len >= 4) {
          if (len % 3 == 1) {
            if (idx + 1 > len - 4) {
              isSpan3 = true;
            }
          }
          if (len % 3 == 2) {
            if (idx + 1 > len - 2) {
              isSpan3 = true;
            }
          }
        }

        return (
          <div
            class={`
              group relative h-95 cursor-default ${isSpan3 ? "col-span-3" : "col-span-2"} max-[900px]:col-span-1 max-[900px]:h-60 overflow-hidden
            `}
          >
            <div
              class="w-full h-full bg-no-repeat bg-center bg-cover scale-100 group-hover:scale-110 duration-800 ease-[ease]"
              style={`background-image: url('${imagePath}');`}
            />

            {allowHover && (
              <>
                <div class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms] group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55" />

                <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
                  <span class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]">
                    {padZero(idx + 1, data.length)}
                  </span>

                  <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]" />

                  <p class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]">
                    {title}
                  </p>

                  <p class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-400">
                    {description}
                  </p>
                </div>
              </>
            )}
          </div>
        );
      })
  }
</div>

{
  showViewMore && (
    <div id={`${galleryId}-viewmore`} class="mt-10 flex justify-center">
      <button class="inline-flex items-center gap-[0.8rem] border border-[rgba(201,169,110,0.4)] px-[2.2rem] py-[0.85rem] font-['Jost',sans-serif] text-[0.72rem] uppercase tracking-[0.22em] text-[#C9A96E] transition-[background,color,border-color] duration-300 hover:border-[#C9A96E] hover:bg-[rgba(201,169,110,0.08)] cursor-pointer">
        <span>View More</span>
      </button>
    </div>
  )
}

<script type="module" lang="ts" define:vars={{ galleryId, data }}>
  const imageGallery = document.getElementById(`${galleryId}-image-gallery`);
  const viewmore = document.getElementById(`${galleryId}-viewmore`);

  viewmore?.addEventListener("click", () => {
    const mappedData = data.map(({ imagePath }) => ({ src: imagePath }));
    openLightbox("global", mappedData, 6, "Test Gallery");
  });
</script>

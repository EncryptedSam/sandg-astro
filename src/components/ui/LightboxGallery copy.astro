---
interface GalleryItem {
  src: string;
  title: string;
  tag: string;
}

interface Props {
  items: GalleryItem[];
  galleryId?: string;
}

const { items, galleryId = "gallery" } = Astro.props;
---

<!-- Gallery -->
<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
  {
    items.map((item, idx) => (
      <button
        class="group overflow-hidden"
        data-lightbox-item
        data-index={idx}
        data-src={item.src}
        data-title={item.title}
        data-tag={item.tag}
      >
        <img
          src={item.src}
          alt={item.title}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      </button>
    ))
  }
</div>

<!-- Lightbox -->
<div
  id={`${galleryId}-lightbox`}
  class="pointer-events-none w-screen h-screen fixed inset-0 z-[10000] flex flex-col items-center justify-center bg-[rgba(8,7,6,0.97)] opacity-0 transition-opacity duration-300"
>
  <!-- Close -->
  <button
    id={`${galleryId}-close`}
    class="absolute top-6 right-6 z-[2] flex h-11 w-11 items-center justify-center border border-[rgba(201,169,110,0.3)] text-[#C9A96E] transition hover:bg-[rgba(201,169,110,0.12)]"
  >
    ✕
  </button>

  <!-- Prev -->
  <button
    id={`${galleryId}-prev`}
    class="absolute left-6 top-1/2 z-[2] flex h-[50px] w-[50px] -translate-y-1/2 items-center justify-center border border-[rgba(201,169,110,0.3)] bg-[rgba(8,7,6,0.6)] text-[1.2rem] text-[#C9A96E] backdrop-blur-sm transition hover:-translate-x-[2px] hover:border-[#C9A96E] hover:bg-[rgba(201,169,110,0.15)]"
  >
    ←
  </button>

  <!-- Next -->
  <button
    id={`${galleryId}-next`}
    class="absolute right-6 top-1/2 z-[2] flex h-[50px] w-[50px] -translate-y-1/2 items-center justify-center border border-[rgba(201,169,110,0.3)] bg-[rgba(8,7,6,0.6)] text-[1.2rem] text-[#C9A96E] backdrop-blur-sm transition hover:translate-x-[2px] hover:border-[#C9A96E] hover:bg-[rgba(201,169,110,0.15)]"
  >
    →
  </button>

  <!-- Image -->
  <div
    class="flex flex-1 items-center justify-center overflow-hidden px-20 pt-20 pb-4 max-md:px-4"
  >
    <img
      id={`${galleryId}-img`}
      src=""
      alt=""
      class="max-h-[72vh] max-w-full select-none border border-[rgba(201,169,110,0.15)] object-contain shadow-[0_0_80px_rgba(0,0,0,0.7)] transition duration-200"
    />
  </div>

  <!-- Caption -->
  <div class="px-8 pt-3 pb-2 text-center">
    <p
      id={`${galleryId}-tag`}
      class="mb-1 text-[0.62rem] tracking-[0.25em] text-[#C9A96E] uppercase"
    >
    </p>

    <p
      id={`${galleryId}-title`}
      class='font-["Cormorant_Garamond"] text-[1.2rem] text-[#F5F0E8]'
    >
    </p>
  </div>

  <!-- Counter -->
  <div
    id={`${galleryId}-counter`}
    class="mb-4 text-[0.65rem] tracking-[0.2em] text-[#8A8175]"
  >
  </div>

  <!-- Thumbs -->
  <div
    id={`${galleryId}-thumbs`}
    class="flex max-w-full gap-2 overflow-x-auto px-8 pb-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
  </div>
</div>

<script define:vars={{ items, galleryId }}>
  const lightbox = document.getElementById(`${galleryId}-lightbox`);
  const lightboxImg = document.getElementById(`${galleryId}-img`);
  const lightboxTag = document.getElementById(`${galleryId}-tag`);
  const lightboxTitle = document.getElementById(`${galleryId}-title`);
  const lightboxCounter = document.getElementById(`${galleryId}-counter`);
  const lightboxThumbs = document.getElementById(`${galleryId}-thumbs`);

  const triggers = document.querySelectorAll("[data-lightbox-item]");

  let currentIdx = 0;

  // Build thumbs
  items.forEach((img, i) => {
    const thumb = document.createElement("img");

    thumb.src = img.src;

    thumb.className =
      "lightbox-thumb h-10 w-[54px] shrink-0 cursor-pointer object-cover border border-transparent opacity-35 transition duration-300";

    thumb.addEventListener("click", () => goToSlide(i));

    lightboxThumbs.appendChild(thumb);
  });

  function updateThumbs() {
    const thumbs = lightboxThumbs.querySelectorAll(".lightbox-thumb");

    thumbs.forEach((thumb, i) => {
      thumb.classList.toggle("opacity-100", i === currentIdx);
      thumb.classList.toggle("border-[#C9A96E]", i === currentIdx);

      thumb.classList.toggle("opacity-35", i !== currentIdx);
    });

    const active = thumbs[currentIdx];

    active?.scrollIntoView({
      behavior: "smooth",
      inline: "center",
      block: "nearest",
    });
  }

  function goToSlide(idx) {
    currentIdx = (idx + items.length) % items.length;

    lightboxImg.classList.add("scale-[0.97]", "opacity-0");

    setTimeout(() => {
      const current = items[currentIdx];

      lightboxImg.src = current.src;
      lightboxTag.textContent = current.tag;
      lightboxTitle.textContent = current.title;
      lightboxCounter.textContent = `${currentIdx + 1} / ${items.length}`;

      updateThumbs();

      lightboxImg.classList.remove("scale-[0.97]", "opacity-0");
    }, 220);
  }

  function openLightbox(idx) {
    currentIdx = idx;

    const current = items[idx];

    lightboxImg.src = current.src;
    lightboxTag.textContent = current.tag;
    lightboxTitle.textContent = current.title;
    lightboxCounter.textContent = `${idx + 1} / ${items.length}`;

    updateThumbs();

    lightbox.classList.remove("pointer-events-none", "opacity-0");
    lightbox.classList.add("pointer-events-auto", "opacity-100");

    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.remove("pointer-events-auto", "opacity-100");
    lightbox.classList.add("pointer-events-none", "opacity-0");

    document.body.style.overflow = "";
  }

  triggers.forEach((item, i) => {
    item.addEventListener("click", () => openLightbox(i));
  });

  document
    .getElementById(`${galleryId}-close`)
    ?.addEventListener("click", closeLightbox);

  document
    .getElementById(`${galleryId}-prev`)
    ?.addEventListener("click", () => goToSlide(currentIdx - 1));

  document
    .getElementById(`${galleryId}-next`)
    ?.addEventListener("click", () => goToSlide(currentIdx + 1));

  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Swipe
  let touchStartX = 0;

  lightbox.addEventListener(
    "touchstart",
    (e) => {
      touchStartX = e.touches[0].clientX;
    },
    { passive: true },
  );

  lightbox.addEventListener("touchend", (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;

    if (Math.abs(diff) > 50) {
      goToSlide(diff > 0 ? currentIdx + 1 : currentIdx - 1);
    }
  });

  // Keyboard
  document.addEventListener("keydown", (e) => {
    const isOpen = lightbox.classList.contains("opacity-100");

    if (!isOpen) return;

    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowRight") goToSlide(currentIdx + 1);
    if (e.key === "ArrowLeft") goToSlide(currentIdx - 1);
  });
</script>

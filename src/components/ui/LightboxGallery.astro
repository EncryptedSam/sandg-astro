---
const galleryId = crypto.randomUUID();
---

<div
  id={`${galleryId}-lightbox`}
  class="fixed hidden flex-col top-0 left-0 w-screen h-screen bg-[#080706f7] z-[9999]"
  tabindex="0"
>
  <div class="flex flex-1 items-center justify-center">
    <div
      id={`${galleryId}-img`}
      class="w-175 bg-contain bg-center bg-no-repeat h-full"
    >
    </div>
    <!-- Close -->
    <button
      id={`${galleryId}-close`}
      class="absolute inline-flex items-center justify-center right-6 top-6 h-12.5 w-12.5 text-[18px] border border-[#c9a96e4d] text-gold cursor-pointer"
    >
      ✕
    </button>
    <!-- Prev -->
    <button
      id={`${galleryId}-prev`}
      class="absolute inline-flex items-center justify-center left-6 h-12.5 w-12.5 text-[18px] border border-[#c9a96e4d] text-gold cursor-pointer"
    >
      ←
    </button>
    <!-- Next -->
    <button
      id={`${galleryId}-next`}
      class="absolute inline-flex items-center justify-center right-6 h-12.5 w-12.5 text-[18px] border border-[#c9a96e4d] text-gold cursor-pointer"
    >
      →
    </button>
  </div>
  <div class="w-full flex flex-col items-center py-6">
    <h1
      id={`${galleryId}-title`}
      class="font-['Cormorant_Garamond'] text-[19.2px] font-light text-[#f5f0e8]"
    >
    </h1>
    <div
      id={`${galleryId}-counter`}
      class="font-['Jost',sans-serif] mb-4 text-text-muted text-[10px] font-light text-center"
    >
      6 / 6
    </div>

    <div
      id={`${galleryId}-thumbs`}
      class="flex max-w-91 space-x-1 overflow-auto"
    >
    </div>
  </div>
</div>

<script type="module" lang="ts" define:vars={{ galleryId }}>
  const lightbox = document.getElementById(`${galleryId}-lightbox`);
  const lightboxTitle = document.getElementById(`${galleryId}-title`);
  const lightboxImg = document.getElementById(`${galleryId}-img`);
  const lightboxCounter = document.getElementById(`${galleryId}-counter`);
  const lightboxThumbs = document.getElementById(`${galleryId}-thumbs`);
  const lightboxNext = document.getElementById(`${galleryId}-next`);
  const lightboxPrev = document.getElementById(`${galleryId}-prev`);
  const lightboxClose = document.getElementById(`${galleryId}-close`);

  lightboxThumbs.replaceChildren();

  let currentIdx = 0;

  const thumbs = [];

  let items = [];

  function goTo(index) {
    if (thumbs.length == 0) return;
    thumbs.forEach((thumb, idx) => {
      thumb.classList.toggle("opacity-100", idx === index);
      thumb.classList.toggle("border-[#C9A96E]", idx === index);
      thumb.classList.toggle("border-transparent", idx !== index);
      thumb.classList.toggle("opacity-35", idx !== index);
    });

    thumbs[index].scrollIntoView({
      behavior: "smooth",
      block: "center",
    });

    lightboxImg.style.backgroundImage = `url('${items[index].src}')`;
    lightboxCounter.innerHTML = `${index + 1} / ${items.length}`;
  }

  function goRight() {
    currentIdx = ++currentIdx % items.length;
    goTo(currentIdx);
  }

  function goLeft() {
    currentIdx = Math.abs(items.length + --currentIdx) % items.length;
    goTo(currentIdx);
  }

  function renderThumbList() {
    items.forEach(({ src }, i) => {
      const thumb = document.createElement("div");
      thumb.style.backgroundImage = `url('${src}')`;
      thumb.className =
        "inline-block shrink-0 w-13 h-9.5 bg-cover bg-no-repeat opacity-35 border border-transparent cursor-pointer transition duration-300";

      thumb.addEventListener("click", () => {
        goTo(i);
        currentIdx = i;
      });
      lightboxThumbs.appendChild(thumb);
      thumbs.push(thumb);
    });
  }

  lightboxNext.addEventListener("click", goRight);

  lightboxPrev.addEventListener("click", goLeft);

  function closeLightbox() {
    lightbox?.classList.remove("flex");
    lightbox?.classList.add("hidden");
  }

  lightboxClose.addEventListener("click", closeLightbox);

  document.addEventListener("keydown", (e) => {
    if (lightbox?.classList.contains("hidden")) return;

    if (!lightbox?.contains(document.activeElement)) return;

    switch (e.key) {
      case "ArrowRight":
        goRight();
        break;

      case "ArrowLeft":
        goLeft();
        break;

      case "Escape":
        closeLightbox();
        break;
    }
  });

  window.addEventListener("open-lightbox", (e) => {
    const { id, data, title, index } = e.detail;

    if (id.toLowerCase() !== "global") return;

    lightbox?.classList.remove("hidden");
    lightbox?.classList.add("flex");
    lightbox?.focus();
    lightboxTitle.innerHTML = title ? title : "Untitled";

    items = [...data];

    renderThumbList();

    currentIdx = index;
    goTo(index);
  });

  function openLightbox(id, data, index, title) {
    window.dispatchEvent(
      new CustomEvent("open-lightbox", {
        detail: { data, index, title, id },
      }),
    );
  }

  window.openLightbox = openLightbox;
</script>

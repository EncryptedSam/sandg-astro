---
import SectionHead from "./shared/SectionHead.astro";

const services: { title: string; description: string }[] = [
  {
    title: "New Home Construction",
    description: "End-to-end design and build solutions.",
  },
  {
    title: "Interior Design",
    description: "Elegant, functional, and personalized spaces.",
  },
  {
    title: "Renovations & Remodeling",
    description: "Modern upgrades for existing properties.",
  },
  {
    title: "Civil Engineering Solutions",
    description: "Structural expertise and project management.",
  },
];
---

<!-- ABOUT -->
<section id="about" class="bg-[#0f0d0a] py-28 px-[5vw]">
  <!-- TAG -->
  <SectionHead 
    tag="Our Heritage" 
    title={[
      {text:"About", highlight:false},
      {text:"Us", highlight:false}
    ]} 
  />

  <!-- GRID -->
  <div class="mt-20 grid gap-20 lg:grid-cols-2 items-center">
    <!-- IMAGE -->
    <div class="relative opacity-0 animate-[fadeUp_0.8s_0.2s_ease_forwards]">
      <img
        src="https://images.unsplash.com/photo-1618219908412-a29a1bb7b86e?w=900&q=85"
        alt="Luxury interior"
        class="h-[580px] w-full object-cover"
      />

      <!-- ACCENT BORDER -->
      <div
        class="absolute top-[-18px] left-[-18px] w-[calc(100%-40px)] h-[calc(100%-40px)] border border-[#c9a96e] opacity-40"
      >
      </div>

      <!-- BADGE -->
      <div
        class="absolute bottom-8 -right-6 bg-[#c9a96e] px-8 py-6 text-center text-[#080706]"
      >
        <div
          class="font-['Cormorant_Garamond'] text-5xl leading-none font-semibold"
        >
          3+
        </div>
        <div class="mt-1 text-[0.65rem] uppercase tracking-[0.15em]">
          Years of<br />Excellence
        </div>
      </div>
    </div>

    <!-- TEXT -->
    <div class="opacity-0 animate-[fadeUp_0.8s_0.4s_ease_forwards]">
      <p
        class="text-left text-[0.65rem] uppercase tracking-[0.35em] text-[#c9a96e]"
      >
        Who We Are
      </p>

      <h2
        class="mt-4 font-['Cormorant_Garamond'] text-[clamp(2.2rem,4vw,3.5rem)] font-light leading-snug text-left"
      >
        Where <em class="text-[#c9a96e] italic">Vision</em><br />
        Meets Mastery
      </h2>

      <p
        class="mt-6 max-w-[560px] text-left text-[0.9rem] leading-[1.9] text-[#8a8070]"
      >
        To provide high-quality construction and interior design services,
        delivered with integrity, professionalism, and a focus on client
        satisfaction.
      </p>

      <!-- FEATURES -->
      <div class="mt-10 flex flex-col gap-6">
        {
          services.map(({ title, description }) => {
            return (
              <div class="flex gap-4 border-b border-[#c9a96e]/10 pb-5">
                <div class="h-10 w-[2px] bg-[#c9a96e] mt-1" />
                <div>
                  <p class="text-[0.85rem] font-medium tracking-wide text-[#e8d5a8]">
                    {title}
                  </p>
                  <p class="mt-1 text-[0.8rem] leading-[1.8] text-[#8a8070]">
                    {description}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

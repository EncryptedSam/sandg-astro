---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#projects", label: "Projects" },
  { href: "#onsite", label: "On Site" },
  { href: "#testimonials", label: "Testimonials" },
  { href: "#founders", label: "Founders" },
  { href: "#contact", label: "Contact" },
];
---

<nav
  data-navbar
  class="fixed bg-linear-to-b flex justify-center items-center from-[rgba(8,7,6,0.95)] to-transparent top-0 left-0 right-0 px-[5vw] py-6 transition-colors duration-300 z-10"
>
  <a href="#" class="mr-auto">
    <!-- <img
      data-logo
      class="h-23.75 transition-all duration-300"
      src={`${import.meta.env.BASE_URL}images/sg-logo-circle-3.svg`}
      alt="S&G Logo"
    /> -->
    <div
      data-logo
      class="h-23.75 w-23.75 transition-all duration-300 bg-no-repeat bg-cover bg-center"
      style={`background-image:url(${import.meta.env.BASE_URL}images/logo-v2.svg)`}
    >
    </div>
  </a>

  <ul class="flex gap-10 list-none absolute max-[1170px]:hidden">
    {
      navLinks.map(({ href, label }) => {
        return (
          <li>
            <a
              class="text-[0.72rem] tracking-[0.2em] uppercase text-cream no-underline opacity-70 transition-all duration-300 hover:opacity-100 hover:text-gold"
              href={href}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>

  <a
    href="#contact"
    class="text-[0.7rem] tracking-[0.2em] uppercase text-gold border border-gold px-6 py-[0.6rem] no-underline transition-colors duration-300 hover:bg-gold hover:text-black max-[1170px]:hidden ml-auto"
    >Get in Touch</a
  >
  <button
    data-hamburger
    class="flex flex-col gap-1 p-2 border border-[#c9a96e]/30 w-10 h-10 items-start justify-center min-[1170px]:hidden cursor-pointer"
  >
    <span class="h-[1px] w-full bg-[#c9a96e]"></span>
    <span class="h-[1px] w-3/4 bg-[#c9a96e]"></span>
    <span class="h-[1px] w-full bg-[#c9a96e]"></span>
  </button>
</nav>

<div
  data-sidenav
  class="fixed hidden w-screen h-screen top-0 right-0 z-50 min-[1170px]:hidden"
>
  <div class="absolute h-full w-full bg-black/70"></div>

  <div
    class="absolute flex flex-col top-0 right-0 w-[400px] h-full bg-[#0a0907fa] border-l border-gold/20 backdrop-blur-xl transition duration-500 p-10 pt-0 overflow-auto z-10"
  >
    <div
      class="w-full flex flex-col shrink-0 sticky top-0 pt-10 bg-[#0a0907fa] backdrop-blur-xl"
    >
      <button
        data-navclose
        class="ml-auto w-10 h-10 border border-gold/30 text-gold hover:text-[#C9A96E] hover:border-gold hover:bg-[#c9a96e1a] cursor-pointer transition duration-300"
        >✕</button
      >
      <a href="#" class="mr-auto shrink-0">
        <img
          class="logo h-23.75 transition-all duration-300"
          src={`${import.meta.env.BASE_URL}images/logo-v2.svg`}
          alt="S&G Logo"
        />
      </a>
    </div>

    <div class="flex-1 mt-10">
      <ul data-navlist class="flex flex-col">
        {
          navLinks.map(({ href, label }) => {
            return (
              <li class="block w-full border-0 border-b border-b-[#c9a96e14]">
                <a
                  class="block font-['Cormorant_Garamond'] leading-[1.7] text-[#f5f0e8] p-[1.1rem_0] text-[#f5f0e8] hover:text-[#c9a96e] text-[1.5rem] pl-0 hover:pl-[17px] transition-all duration-300"
                  href={href}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
    <div class="shrink-0">
      <a
        class="mt-10 inline-block border border-[#c9a96e] text-[#c9a96e] px-6 py-3 uppercase text-xs tracking-[0.2em] text-[0.7rem]"
      >
        Get in Touch
      </a>
      <p
        class="block mt-8 text-xs text-[#8a8070] tracking-[0.15em] shrink-0 text-[0.65rem]"
      >
        Est. 2008 · Hyderabad, India
      </p>
    </div>
  </div>
</div>

<script type="module">
  const nav = document.querySelector("[data-navbar]");
  const logo = document.querySelector("[data-logo]");

  const handleResize = () => {
    if (window.scrollY > 50) {
      nav?.classList.add(
        "bg-[rgba(8,7,6,0.97)]",
        "border-b",
        "border-[rgba(201,169,110,0.15)]",
      );

      nav?.classList.remove(
        "bg-gradient-to-b",
        "from-[rgba(8,7,6,0.95)]",
        "to-transparent",
      );

      logo?.classList.add("h-[60px]", "w-[60px]");
      logo?.classList.remove("h-[95px]", "w-[95px]");

      if (logo) {
        logo.style.backgroundSize = "270%";
      }
    } else {
      nav?.classList.remove(
        "bg-[rgba(8,7,6,0.97)]",
        "border-b",
        "border-[rgba(201,169,110,0.15)]",
      );

      nav?.classList.add(
        "bg-gradient-to-b",
        "from-[rgba(8,7,6,0.95)]",
        "to-transparent",
      );

      logo?.classList.add("h-[95px]", "w-[95px]");
      logo?.classList.remove("h-[60px]", "w-[60px]");
      if (logo) {
        logo.style.backgroundSize = "100%";
      }
    }
  };

  window.addEventListener("scroll", handleResize);
  handleResize();

  const ham = document.querySelector("[data-hamburger]");
  const sidenav = document.querySelector("[data-sidenav]");
  const navclosebtn = sidenav.querySelector("[data-navclose]");
  const navlist = sidenav.querySelectorAll("[data-navlist] li");

  const toggleSidenav = () => {
    sidenav?.classList.toggle("hidden");
  };

  ham?.addEventListener("click", toggleSidenav);

  navclosebtn?.addEventListener("click", toggleSidenav);

  navlist?.forEach((nav) => {
    nav?.addEventListener("click", toggleSidenav);
  });
</script>

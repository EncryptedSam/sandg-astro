    </li>
    <li>
      <a
        class="text-[0.72rem] tracking-[0.2em] uppercase text-cream no-underline opacity-70 transition-all duration-300 hover:opacity-100 hover:text-gold"
        href="#projects">Projects</a
      >
    </li>
    <li>
      <a

<!-- HERO -->
<section
  id="hero"
  class="relative flex min-h-[700px] h-screen items-center overflow-hidden p-[7rem_5vw]"
>
  <!-- BG -->
  <div
    class="absolute inset-0 bg-cover bg-center animate-[heroZoom_12s_ease-out_forwards]"
    style='
          background-image: url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1800&q=85");
        '
  >
  </div>

  <!-- OVERLAY -->
  <div
    class="absolute inset-0 bg-[linear-gradient(105deg,rgba(8,7,6,0.88)_0%,rgba(8,7,6,0.5)_50%,rgba(8,7,6,0.3)_100%)]"
  >
  </div>

  <!-- CONTENT -->
  <div
    class="relative z-[2] max-w-[800px] px-[5vw] opacity-0 animate-[fadeUp_1.2s_0.5s_ease_forwards]"
  >
    <p
      class="mb-6 flex items-center gap-4 text-[0.7rem] uppercase tracking-[0.35em] text-[#c9a96e]"
    >
      <span class="block h-px w-10 bg-[#c9a96e]"></span>
      Est. 2008 · Luxury Construction & Design
    </p>

    <h1
      class="mb-6 font-['Cormorant_Garamond'] text-[clamp(3.5rem,7vw,7rem)] font-light leading-[1.05] tracking-[0.02em]"
    >
      Crafting Spaces<br />
      of <em class="italic text-[#c9a96e]">Timeless</em><br />
      Elegance
    </h1>

    <p
      class="mb-12 max-w-[480px] text-[0.9rem] leading-[1.9] tracking-[0.03em] text-[rgba(245,240,232,0.65)]"
    >
      We transform visions into architectural masterpieces — blending superior
      craftsmanship with refined interiors that define a new standard of luxury.
    </p>

    <div class="flex flex-wrap items-center gap-6">
      <a
        href="#projects"
        class="bg-[#c9a96e] px-10 py-4 text-[0.72rem] font-medium uppercase tracking-[0.2em] text-[#080706] transition duration-300 hover:-translate-y-[2px] hover:bg-[#e8d5a8]"
      >
        View Our Work
      </a>

      <a
        href="#about"
        class="border-b border-[rgba(245,240,232,0.3)] py-4 text-[0.72rem] uppercase tracking-[0.2em] text-[#f5f0e8] transition duration-300 hover:border-[#c9a96e] hover:text-[#c9a96e]"
      >
        Discover Aurum
      </a>
    </div>
  </div>

  <!-- STATS -->
  <div
    class="absolute bottom-16 right-[5vw] z-[2] hidden gap-12 opacity-0 animate-[fadeUp_1.2s_1s_ease_forwards] md:flex"
  >
    <div class="text-center">
      <div
        class="font-['Cormorant_Garamond'] text-[2.8rem] leading-none font-light text-[#c9a96e]"
      >
        280+
      </div>
      <div
        class="mt-1 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070]"
      >
        Projects Completed
      </div>
    </div>

    <div class="text-center">
      <div
        class="font-['Cormorant_Garamond'] text-[2.8rem] leading-none font-light text-[#c9a96e]"
      >
        15+
      </div>
      <div
        class="mt-1 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070]"
      >
        Years Excellence
      </div>
    </div>

    <div class="text-center">
      <div
        class="font-['Cormorant_Garamond'] text-[2.8rem] leading-none font-light text-[#c9a96e]"
      >
        48
      </div>
      <div
        class="mt-1 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070]"
      >
        Happy Clients
      </div>
    </div>
  </div>

  <!-- SCROLL -->
  <a
    href="#about"
    class="absolute bottom-8 left-1/2 z-[2] flex -translate-x-1/2 flex-col items-center gap-2 text-[0.6rem] uppercase tracking-[0.2em] text-[#c9a96e] opacity-0 animate-[fadeUp_1.2s_1.5s_ease_forwards]"
  >
    <span>Scroll</span>

    <div
      class="h-10 w-px animate-[scrollPulse_2s_infinite] bg-[linear-gradient(to_bottom,#c9a96e,transparent)]"
    >
    </div>
  </a>
</section>

---
const processSteps = [
  {
    number: "I",
    title: "Consultation",
    description:
      "We begin with a detailed discussion to understand your vision, goals, and the unique character you want your space to embody.",
  },
  {
    number: "II",
    title: "Design",
    description:
      "Our designers craft refined concepts, curated materials, and elegant visual direction tailored to your lifestyle and aspirations.",
  },
  {
    number: "III",
    title: "Planning",
    description:
      "Every detail is meticulously organized through strategic planning, technical precision, and seamless project coordination.",
  },
  {
    number: "IV",
    title: "Implementation",
    description:
      "Skilled craftsmen and specialists bring the vision to life with exceptional quality, precision, and attention to detail.",
  },
  {
    number: "V",
    title: "Completion",
    description:
      "We deliver a finished space with final refinements, documentation, and continued support to ensure a lasting legacy.",
  },
];
---

<section id="process" class="px-[5vw] py-28">
  <p
    class="section-tag reveal mb-4 text-center text-[0.65rem] uppercase tracking-[0.35em] text-[#c9a96e]"
  >
    How We Work
  </p>

  <h2
    class="section-title reveal mb-6 text-center font-['Cormorant_Garamond'] text-[clamp(2.2rem,4vw,3.5rem)] font-light leading-[1.2]"
  >
    Our <em class="italic text-[#c9a96e]">Process</em>
  </h2>

  <div
    class="ornament reveal mx-auto mb-6 flex items-center justify-center gap-4"
  >
    <div
      class="h-px w-full max-w-[120px] bg-[linear-gradient(to_right,transparent,#c9a96e,transparent)]"
    >
    </div>

    <div class="h-2 w-2 shrink-0 rotate-45 bg-[#c9a96e]"></div>

    <div
      class="h-px w-full max-w-[120px] bg-[linear-gradient(to_right,transparent,#c9a96e,transparent)]"
    >
    </div>
  </div>

  <div
    class="process-steps reveal relative mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-5"
  >
    <!-- Line -->
    <div
      class="absolute left-[12%] right-[12%] top-10 hidden h-px bg-[linear-gradient(to_right,transparent,#c9a96e,transparent)] lg:block"
    >
    </div>

    {
      processSteps.map(({ description, number, title }) => {
        return (
          <div class="relative z-[1] px-6 text-center">
            <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center border border-[#c9a96e] bg-[#1a1710] font-['Cormorant_Garamond'] text-[1.6rem] font-light text-[#c9a96e]">
              {number}
            </div>

            <p class="mb-3 text-[0.9rem] font-medium tracking-[0.05em] text-[#f5f0e8]">
              {title}
            </p>

            <p class="text-[0.78rem] leading-[1.9] text-[#8a8070]">
              {description}{" "}
            </p>
          </div>
        );
      })
    }
  </div>
</section>

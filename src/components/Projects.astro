---
import SectionHead from "./shared/SectionHead.astro";
import ImageGallery, { type ImageCardProps } from "./ui/ImageGallery.astro";

const data: ImageCardProps[] = [
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_1.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_2.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_3.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_5.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_7.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_6.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_8.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_9.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/cmpltd_image_4.jpeg`,
  },
];
---

<section id="projects" class="px-[5vw] py-28">
  <SectionHead
    tag="Portfolio"
    title={[
      { text: "Completed", highlight: false },
      { text: "Projects", highlight: true },
    ]}
    description="Completed projects that stand the test of time — thoughtfully built spaces shaped through precision, detail, and a commitment to quality from foundation to finish."
  />

  <div class="mt-20">
    <ImageGallery galleryId="projects" data={data} allowHover={false} />
  </div>
</section>

---
import SectionHead from "./shared/SectionHead.astro";
---

<section id="projects" class="px-[5vw] py-28">
  <SectionHead
    tag="Portfolio"
    title={[
      { text: "Completed", highlight: false },
      { text: "Projects", highlight: true },
    ]}
  />


  <!-- Grid -->
  <div
    class="projects-grid reveal mt-20! grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-12"
  >
    <!-- Project 1 -->
    <div class="group relative overflow-hidden md:h-[460px] xl:col-span-7">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=900&q=80"
        alt="The Ivory Estate"
        class="h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-[1.08]"
      />

      <div
        class="absolute inset-0 flex items-end bg-[rgba(8,7,6,0)] p-8 transition-all duration-500 group-hover:bg-[rgba(8,7,6,0.75)]"
      >
        <div
          class="translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <p
            class="mb-2 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e]"
          >
            Residential · 2024
          </p>

          <p
            class="mb-1 font-['Cormorant_Garamond'] text-[1.5rem] text-[#f5f0e8]"
          >
            The Ivory Estate
          </p>

          <p class="text-[0.75rem] text-[#8a8070]">Hyderabad, Telangana</p>
        </div>
      </div>
    </div>

    <!-- Project 2 -->
    <div class="group relative overflow-hidden md:h-[460px] xl:col-span-5">
      <img
        src="https://images.unsplash.com/photo-1631679706909-1844bbd07221?w=700&q=80"
        alt="Aurum Suites"
        class="h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-[1.08]"
      />

      <div
        class="absolute inset-0 flex items-end bg-[rgba(8,7,6,0)] p-8 transition-all duration-500 group-hover:bg-[rgba(8,7,6,0.75)]"
      >
        <div
          class="translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <p
            class="mb-2 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e]"
          >
            Hospitality · 2023
          </p>

          <p
            class="mb-1 font-['Cormorant_Garamond'] text-[1.5rem] text-[#f5f0e8]"
          >
            Aurum Suites
          </p>

          <p class="text-[0.75rem] text-[#8a8070]">Mumbai, Maharashtra</p>
        </div>
      </div>
    </div>

    <!-- Project 3 -->
    <div class="group relative overflow-hidden md:h-[360px] xl:col-span-5">
      <img
        src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=700&q=80"
        alt="Velvet Penthouse"
        class="h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-[1.08]"
      />

      <div
        class="absolute inset-0 flex items-end bg-[rgba(8,7,6,0)] p-8 transition-all duration-500 group-hover:bg-[rgba(8,7,6,0.75)]"
      >
        <div
          class="translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <p
            class="mb-2 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e]"
          >
            Residential · 2023
          </p>

          <p
            class="mb-1 font-['Cormorant_Garamond'] text-[1.5rem] text-[#f5f0e8]"
          >
            Velvet Penthouse
          </p>

          <p class="text-[0.75rem] text-[#8a8070]">Bengaluru, Karnataka</p>
        </div>
      </div>
    </div>

    <!-- Project 4 -->
    <div class="group relative overflow-hidden md:h-[360px] xl:col-span-7">
      <img
        src="https://images.unsplash.com/photo-1564078516393-cf04bd966897?w=900&q=80"
        alt="The Obsidian Tower"
        class="h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-[1.08]"
      />

      <div
        class="absolute inset-0 flex items-end bg-[rgba(8,7,6,0)] p-8 transition-all duration-500 group-hover:bg-[rgba(8,7,6,0.75)]"
      >
        <div
          class="translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
        >
          <p
            class="mb-2 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e]"
          >
            Commercial · 2022
          </p>

          <p
            class="mb-1 font-['Cormorant_Garamond'] text-[1.5rem] text-[#f5f0e8]"
          >
            The Obsidian Tower
          </p>

          <p class="text-[0.75rem] text-[#8a8070]">Delhi NCR</p>
        </div>
      </div>
    </div>
  </div>
</section>

---
import SectionHead from "./shared/SectionHead.astro";

const services = {
  constructionServices: [
    {
      title: "New Home Construction",
      description:
        "Complete home building solutions from planning to finishing.",
    },
    {
      title: "Home Additions & Renovations",
      description: "Expand and upgrade existing spaces with modern designs.",
    },
    {
      title: "Commercial Construction",
      description:
        "Reliable construction services for offices and business spaces.",
    },
    {
      title: "Structural Repairs",
      description:
        "Repair and strengthen damaged structural components safely.",
    },
    {
      title: "Foundation Work",
      description: "Strong and durable foundation solutions for all projects.",
    },
  ],

  interiorDesignServices: [
    {
      title: "Space Planning",
      description: "Optimize room layouts for comfort and functionality.",
    },
    {
      title: "Color Consultation",
      description: "Choose color palettes that match your style and mood.",
    },
    {
      title: "Furniture Selection",
      description: "Carefully selected furniture for beauty and practicality.",
    },
    {
      title: "Lighting Design",
      description: "Enhance interiors with balanced and stylish lighting.",
    },
    {
      title: "Material Selection",
      description: "Pick quality materials for elegant and durable interiors.",
    },
    {
      title: "Home Staging",
      description:
        "Prepare homes with attractive styling for better presentation.",
    },
  ],
};
---

<section id="services" class="px-[5vw] py-28">
  <SectionHead
    tag="What We Offer"
    title={[
      { text: "Our", highlight: false },
      { text: "Services", highlight: true },
    ]}
    description="From sweeping residences to distinguished commercial spaces, our suite of services covers every dimension of the built environment."
  />

  <!-- Services Grid -->
  <div
    class="services-grid reveal mt-16 grid gap-[2px] md:grid-cols-2 xl:grid-cols-3"
  >
    <!-- Card -->
    <div class="group relative h-[420px] overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=700&q=80"
        alt="Luxury Residences"
        class="h-full w-full object-cover transition-transform duration-[800ms] ease-in-out group-hover:scale-110"
      />

      <div
        class="absolute inset-0 bg-[linear-gradient(to_top,rgba(8,7,6,0.95)_0%,rgba(8,7,6,0.3)_60%,transparent_100%)] transition-all duration-500 group-hover:bg-[linear-gradient(to_top,rgba(8,7,6,0.98)_0%,rgba(8,7,6,0.6)_100%)]"
      >
      </div>

      <div class="absolute inset-x-0 bottom-0 p-8">
        <div
          class="mb-2 font-['Cormorant_Garamond'] text-[4rem] font-light leading-none text-[rgba(201,169,110,0.15)]"
        >
          01
        </div>

        <div class="mb-3 h-px w-[30px] bg-[#c9a96e]"></div>

        <p
          class="mb-2 font-['Cormorant_Garamond'] text-[1.6rem] font-normal text-[#f5f0e8]"
        >
          Luxury Residences
        </p>

        <p
          class="max-h-0 overflow-hidden text-[0.78rem] leading-[1.8] text-[#8a8070] opacity-0 transition-all duration-500 group-hover:max-h-[100px] group-hover:opacity-100"
        >
          Custom-built homes of unrivalled quality, tailored to your vision and
          lifestyle.
        </p>
      </div>
    </div>

    <!-- Card -->
    <div class="group relative h-[420px] overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=700&q=80"
        alt="Interior Design"
        class="h-full w-full object-cover transition-transform duration-[800ms] ease-in-out group-hover:scale-110"
      />

      <div
        class="absolute inset-0 bg-[linear-gradient(to_top,rgba(8,7,6,0.95)_0%,rgba(8,7,6,0.3)_60%,transparent_100%)] transition-all duration-500 group-hover:bg-[linear-gradient(to_top,rgba(8,7,6,0.98)_0%,rgba(8,7,6,0.6)_100%)]"
      >
      </div>

      <div class="absolute inset-x-0 bottom-0 p-8">
        <div
          class="mb-2 font-['Cormorant_Garamond'] text-[4rem] font-light leading-none text-[rgba(201,169,110,0.15)]"
        >
          02
        </div>

        <div class="mb-3 h-px w-[30px] bg-[#c9a96e]"></div>

        <p
          class="mb-2 font-['Cormorant_Garamond'] text-[1.6rem] font-normal text-[#f5f0e8]"
        >
          Interior Design
        </p>

        <p
          class="max-h-0 overflow-hidden text-[0.78rem] leading-[1.8] text-[#8a8070] opacity-0 transition-all duration-500 group-hover:max-h-[100px] group-hover:opacity-100"
        >
          Signature interiors that blend art, culture, and couture materiality
          seamlessly.
        </p>
      </div>
    </div>

    <!-- Card -->
    <div
      class="group relative h-[420px] overflow-hidden md:col-span-2 xl:col-span-1"
    >
      <img
        src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=700&q=80"
        alt="Commercial Spaces"
        class="h-full w-full object-cover transition-transform duration-[800ms] ease-in-out group-hover:scale-110"
      />

      <div
        class="absolute inset-0 bg-[linear-gradient(to_top,rgba(8,7,6,0.95)_0%,rgba(8,7,6,0.3)_60%,transparent_100%)] transition-all duration-500 group-hover:bg-[linear-gradient(to_top,rgba(8,7,6,0.98)_0%,rgba(8,7,6,0.6)_100%)]"
      >
      </div>

      <div class="absolute inset-x-0 bottom-0 p-8">
        <div
          class="mb-2 font-['Cormorant_Garamond'] text-[4rem] font-light leading-none text-[rgba(201,169,110,0.15)]"
        >
          03
        </div>

        <div class="mb-3 h-px w-[30px] bg-[#c9a96e]"></div>

        <p
          class="mb-2 font-['Cormorant_Garamond'] text-[1.6rem] font-normal text-[#f5f0e8]"
        >
          Commercial Spaces
        </p>

        <p
          class="max-h-0 overflow-hidden text-[0.78rem] leading-[1.8] text-[#8a8070] opacity-0 transition-all duration-500 group-hover:max-h-[100px] group-hover:opacity-100"
        >
          Corporate environments and hospitality venues designed for distinction
          and performance.
        </p>
      </div>
    </div>
  </div>
</section>


---
import SectionHead from "./shared/SectionHead.astro";

const services = {
  constructionServices: [
    {
      title: "New Home Construction",
      description:
        "Complete home building solutions from planning to finishing.",
    },
    {
      title: "Home Additions & Renovations",
      description: "Expand and upgrade existing spaces with modern designs.",
    },
    {
      title: "Commercial Construction",
      description:
        "Reliable construction services for offices and business spaces.",
    },
    {
      title: "Structural Repairs",
      description:
        "Repair and strengthen damaged structural components safely.",
    },
    {
      title: "Foundation Work",
      description: "Strong and durable foundation solutions for all projects.",
    },
  ],

  interiorDesignServices: [
    {
      title: "Space Planning",
      description: "Optimize room layouts for comfort and functionality.",
    },
    {
      title: "Color Consultation",
      description: "Choose color palettes that match your style and mood.",
    },
    {
      title: "Furniture Selection",
      description: "Carefully selected furniture for beauty and practicality.",
    },
    {
      title: "Lighting Design",
      description: "Enhance interiors with balanced and stylish lighting.",
    },
    {
      title: "Material Selection",
      description: "Pick quality materials for elegant and durable interiors.",
    },
    {
      title: "Home Staging",
      description:
        "Prepare homes with attractive styling for better presentation.",
    },
  ],
};
---

<section id="services" class="py-28 px-[5vw] bg-[#080706]">
  <!-- Header -->
  <p
    class="reveal text-[0.65rem] tracking-[0.35em] uppercase text-[#c9a96e] mb-4 text-center"
  >
    What We Offer
  </p>

  <h2
    class="reveal font-['Cormorant_Garamond',serif] text-[clamp(2.2rem,4vw,3.5rem)] font-light leading-[1.2] text-center mb-6"
  >
    Our <em class="italic text-[#c9a96e]">Services</em>
  </h2>

  <!-- Ornament -->
  <div class="reveal flex items-center gap-4 justify-center mx-auto">
    <div
      class="flex-1 h-px bg-gradient-to-r from-transparent via-[#c9a96e] to-transparent max-w-[120px]"
    >
    </div>
    <div class="w-2 h-2 bg-[#c9a96e] rotate-45 shrink-0"></div>
    <div
      class="flex-1 h-px bg-gradient-to-r from-transparent via-[#c9a96e] to-transparent max-w-[120px]"
    >
    </div>
  </div>

  <p
    class="reveal text-center text-[#8a8070] text-[0.9rem] leading-[1.9] max-w-[560px] mx-auto mt-6 mb-0 tracking-[0.03em]"
  >
    From the ground up to the finishing touch — two disciplines, one standard of
    excellence.
  </p>

  <!-- ── Tab bar ── -->
  <div
    class="srv-tabs reveal flex justify-center mt-12 mx-auto mb-10 border border-[#c9a96e]/20 w-fit max-[900px]:flex-col max-[900px]:w-full"
  >
    <button
      class="srv-tab active flex items-center gap-[0.6rem] py-[0.9rem] px-[2.2rem] font-['Jost',sans-serif] text-[0.72rem] tracking-[0.18em] uppercase bg-transparent border-0 text-[#8a8070] cursor-pointer transition-colors duration-300"
      data-tab="construction"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="shrink-0"
      >
        <path d="M3 21h18M9 21V7l6-4v18M9 11h6"></path>
      </svg>
      Construction
    </button>

    <button
      class="srv-tab flex items-center gap-[0.6rem] py-[0.9rem] px-[2.2rem] font-['Jost',sans-serif] text-[0.72rem] tracking-[0.18em] uppercase bg-transparent border-0 border-l border-[#c9a96e]/20 text-[#8a8070] cursor-pointer transition-colors duration-300 max-[900px]:border-l-0 max-[900px]:border-t max-[900px]:border-t-[#c9a96e]/20"
      data-tab="interior"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="shrink-0"
      >
        <rect x="3" y="3" width="18" height="18" rx="1"></rect>
        <path d="M3 9h18M9 21V9"></path>
      </svg>
      Interior Design
    </button>
  </div>

  <!-- ══════════════════════════ CONSTRUCTION PANEL ══════ -->
  <div class="srv-panel active" id="tab-construction">
    <!--
      Layout: 6-col grid
      Cards 1-3 → col-span-2  (top row, equal thirds)
      Cards 4-5 → col-span-3  (bottom row, halves)
      Mobile  → 2 cols, each card col-span-1
    -->
    <div class="grid grid-cols-6 gap-[2px] max-[900px]:grid-cols-2">
      <!-- Card 01 – New Home Construction -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default col-span-2 max-[900px]:col-span-1 max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=700&q=80"
          alt="New Home Construction"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >01</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            New Home Construction
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Complete home building solutions from planning to finishing.
          </p>
        </div>
      </div>

      <!-- Card 02 – Home Additions & Renovations -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default col-span-2 max-[900px]:col-span-1 max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1574359411659-15573a27fd0c?w=700&q=80"
          alt="Home Additions & Renovations"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >02</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Home Additions & Renovations
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Expand and upgrade existing spaces with modern designs.
          </p>
        </div>
      </div>

      <!-- Card 03 – Commercial Construction -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default col-span-2 max-[900px]:col-span-1 max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=700&q=80"
          alt="Commercial Construction"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"

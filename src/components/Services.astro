---
import SectionHead from "./shared/SectionHead.astro";
import ImageGallery, { type ImageCardProps } from "./ui/ImageGallery.astro";

interface Services {
  constructionServices: ImageCardProps[];
  interiorDesignServices: ImageCardProps[];
}

const services: Services = {
  constructionServices: [
    {
      title: "New Home Construction",
      description:
        "Complete home building solutions from planning to finishing.",
      imagePath:
        "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=700&q=80",
    },
    {
      title: "Home Additions & Renovations",
      description: "Expand and upgrade existing spaces with modern designs.",
      imagePath:
        "https://images.unsplash.com/photo-1574359411659-15573a27fd0c?w=700&q=80",
    },
    {
      title: "Commercial Construction",
      description:
        "Reliable construction services for offices and business spaces.",
      imagePath:
        "https://images.unsplash.com/photo-1497366216548-37526070297c?w=700&q=80",
    },
    {
      title: "Structural Repairs",
      description:
        "Repair and strengthen damaged structural components safely.",
      imagePath:
        "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&q=80",
    },
    {
      title: "Foundation Work",
      description: "Strong and durable foundation solutions for all projects.",
      imagePath:
        "https://images.unsplash.com/photo-1685464197644-41d9b07e1e73?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    },
  ],

  interiorDesignServices: [
    {
      title: "Space Planning",
      description: "Optimize room layouts for comfort and functionality.",
      imagePath:
        "https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=700&q=80",
    },
    {
      title: "Color Consultation",
      description: "Choose color palettes that match your style and mood.",
      imagePath:
        "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80",
    },
    {
      title: "Furniture Selection",
      description: "Carefully selected furniture for beauty and practicality.",
      imagePath:
        "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=700&q=80",
    },
    {
      title: "Lighting Design",
      description: "Enhance interiors with balanced and stylish lighting.",
      imagePath:
        "https://images.unsplash.com/photo-1565814636199-ae8133055c1c?w=700&q=80",
    },
    {
      title: "Material Selection",
      description: "Pick quality materials for elegant and durable interiors.",
      imagePath:
        "https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=700&q=80",
    },
    {
      title: "Home Staging",
      description:
        "Prepare homes with attractive styling for better presentation.",
      imagePath:
        "https://images.unsplash.com/photo-1631679706909-1844bbd07221?w=700&q=80",
    },
  ],
};
---

<section id="services" class="py-28 px-[5vw] bg-[#080706]">
  <!-- Header -->

  <SectionHead
    tag="What We Offer"
    title={[
      { text: "Our", highlight: false },
      { text: "Services", highlight: true },
    ]}
    description="From the ground up to the finishing touch — two disciplines, one standard of excellence."
  />

  <!-- ── Tab bar ── -->
  <div
    class="srv-tabs reveal flex justify-center mt-12 mx-auto mb-10 border border-[#c9a96e]/20 w-fit max-[900px]:flex-col max-[900px]:w-full"
  >
    <button
      class="srv-tab active flex items-center gap-[0.6rem] py-[0.9rem] px-[2.2rem] font-['Jost',sans-serif] text-[0.72rem] tracking-[0.18em] uppercase bg-transparent border-0 text-[#8a8070] cursor-pointer transition-colors duration-300"
      data-tab="construction"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="shrink-0"
      >
        <path d="M3 21h18M9 21V7l6-4v18M9 11h6"></path>
      </svg>
      Construction
    </button>

    <button
      class="srv-tab flex items-center gap-[0.6rem] py-[0.9rem] px-[2.2rem] font-['Jost',sans-serif] text-[0.72rem] tracking-[0.18em] uppercase bg-transparent border-0 border-l border-[#c9a96e]/20 text-[#8a8070] cursor-pointer transition-colors duration-300 max-[900px]:border-l-0 max-[900px]:border-t max-[900px]:border-t-[#c9a96e]/20"
      data-tab="interior"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="shrink-0"
      >
        <rect x="3" y="3" width="18" height="18" rx="1"></rect>
        <path d="M3 9h18M9 21V9"></path>
      </svg>
      Interior Design
    </button>
  </div>

  <!-- ══════════════════════════ CONSTRUCTION PANEL ══════ -->
  <div class="srv-panel active" id="tab-construction">
    <ImageGallery data={services.constructionServices} allowHover />
  </div><!-- /tab-construction -->

  <!-- ══════════════════════════ INTERIOR DESIGN PANEL ══ -->
  <div class="srv-panel" id="tab-interior">
    <ImageGallery data={services.interiorDesignServices} allowHover />
  </div><!-- /tab-interior -->
</section>

<script>
  document.querySelectorAll<HTMLElement>(".srv-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>(".srv-tab").forEach((t) => {
        t.classList.remove("active");
      });

      document.querySelectorAll<HTMLElement>(".srv-panel").forEach((p) => {
        p.classList.remove("active");
      });

      tab.classList.add("active");

      const panel = document.getElementById(`tab-${tab.dataset.tab}`);

      if (panel) {
        panel.classList.add("active");
      }
    });
  });
</script>

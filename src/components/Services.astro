          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Commercial Construction
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Reliable construction services for offices and business spaces.
          </p>
        </div>
      </div>

      <!-- Card 04 – Structural Repairs -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default col-span-3 max-[900px]:col-span-1 max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&q=80"
          alt="Structural Repairs"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >04</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Structural Repairs
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Repair and strengthen damaged structural components safely.
          </p>
        </div>
      </div>

      <!-- Card 05 – Foundation Work -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default col-span-3 max-[900px]:col-span-1 max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1590664216291-af7f26dfafce?w=700&q=80"
          alt="Foundation Work"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >05</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Foundation Work
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Strong and durable foundation solutions for all projects.
          </p>
        </div>
      </div>
    </div>
  </div><!-- /tab-construction -->

  <!-- ══════════════════════════ INTERIOR DESIGN PANEL ══ -->
  <div class="srv-panel" id="tab-interior">
    <!--
      Layout: 3-col grid, 6 equal cards
      Mobile → 2 cols
    -->
    <div class="grid grid-cols-3 gap-[2px] max-[900px]:grid-cols-2">
      <!-- Card 01 – Space Planning -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=700&q=80"
          alt="Space Planning"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >01</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Space Planning
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Optimize room layouts for comfort and functionality.
          </p>
        </div>
      </div>

      <!-- Card 02 – Color Consultation -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80"
          alt="Color Consultation"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >02</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Color Consultation
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Choose color palettes that match your style and mood.
          </p>
        </div>
      </div>

      <!-- Card 03 – Furniture Selection -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=700&q=80"
          alt="Furniture Selection"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >03</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Furniture Selection
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Carefully selected furniture for beauty and practicality.
          </p>
        </div>
      </div>

      <!-- Card 04 – Lighting Design -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1565814636199-ae8133055c1c?w=700&q=80"
          alt="Lighting Design"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"
            >04</span
          >
          <div class="w-7 h-px bg-[#c9a96e] mb-[0.7rem]"></div>
          <p
            class="font-['Cormorant_Garamond',serif] text-[1.35rem] font-normal text-[#f5f0e8] mb-[0.4rem]"
          >
            Lighting Design
          </p>
          <p
            class="srv-card-desc text-[0.76rem] text-[#8a8070] leading-[1.8] max-h-0 overflow-hidden opacity-0 transition-all duration-[400ms]"
          >
            Enhance interiors with balanced and stylish lighting.
          </p>
        </div>
      </div>

      <!-- Card 05 – Material Selection -->
      <div
        class="srv-card-img group relative overflow-hidden h-[380px] cursor-default max-[900px]:h-[240px]"
      >
        <img
          src="https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=700&q=80"
          alt="Material Selection"
          class="w-full h-full object-cover block transition-[transform,filter] duration-[800ms] ease-[ease] brightness-75 group-hover:scale-[1.08] group-hover:brightness-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#080706]/[.96] via-[#080706]/20 to-transparent transition-all duration-[400ms]
                    group-hover:from-[#080706] group-hover:via-[#080706]/55 group-hover:to-[#080706]/55"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-[1.8rem]">
          <span
            class="font-['Cormorant_Garamond',serif] text-[3.5rem] font-light text-[#c9a96e]/[.18] leading-none block mb-[0.4rem]"

---
import SectionHead from "./shared/SectionHead.astro";
import ImageGallery, { type ImageCardProps } from "./ui/ImageGallery.astro";

const data: ImageCardProps[] = [
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_1.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_2.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_3.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_4.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_5.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_10.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_6.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_7.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_8.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_9.jpeg`,
  },
  {
    imagePath: `${import.meta.env.BASE_URL}images/onsite_image_11.jpeg`,
  },
];
---

<section id="onsite" class="px-[5vw] py-28">
  <SectionHead
    tag="On Site"
    title={[
      { text: "Raw &", highlight: false },
      { text: "Unfiltered", highlight: true },
    ]}
    description="Unedited moments captured on site — the grit, craft, and human hands behind every space we create. Before the polish, there is the process."
  />

  <div class="mt-20">
    <ImageGallery data={data} allowHover={false} galleryId="onsite" />
  </div>
</section>

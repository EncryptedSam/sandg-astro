---
import SectionHead from "./shared/SectionHead.astro";
import ImageGallery, { type ImageCardProps } from "./ui/ImageGallery.astro";

const data: ImageCardProps[] = [
  {
    imagePath:
      "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=900&q=80",
  },
  {
    imagePath:
      "https://images.unsplash.com/photo-1631679706909-1844bbd07221?w=700&q=80",
  },
  {
    imagePath:
      "https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=700&q=80",
  },
  {
    imagePath:
      "https://images.unsplash.com/photo-1564078516393-cf04bd966897?w=900&q=80",
  },
];
---

<section id="onsite" class="px-[5vw] py-28">
  <SectionHead
    tag="On Site"
    title={[
      { text: "Raw &", highlight: false },
      { text: "Unfiltered", highlight: true },
    ]}
    description="Unedited moments captured on site — the grit, craft, and human hands behind every space we create. Before the polish, there is the process."
  />

  <div class="mt-20">
    <ImageGallery data={data} allowHover={false} />
  </div>
</section>

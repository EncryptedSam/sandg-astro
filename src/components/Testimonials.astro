---
const testimonials = [
  {
    testimonial:
      "Auspicious Homes exceeded our expectations with their professionalism, attention to detail, and ability to bring our vision to life seamlessly.",
    clientName: "Sameer",
    addr: "Bandlaguda Jagir",
  },
  {
    testimonial:
      "They transformed our office into a modern and highly functional space with exceptional expertise, creativity, and care.",
    clientName: "Chandra Shekar",
    addr: "Manneguda",
  },
  {
    testimonial:
      "From the initial consultation to the final reveal, the entire process was smooth, stress free, and beautifully executed.",
    clientName: "KK Radha Mohan",
    addr: "Bion B 1607",
  },
  {
    testimonial:
      "Their team turned our dream home into reality with remarkable craftsmanship, dedication, and attention to every detail.",
    clientName: "Raghu Ram",
    addr: "EIPL Corner Stone 1408",
  },
];
---

<section id="testimonials" class="px-[5vw] py-28">
  <p
    class="section-tag reveal mb-4 text-center text-[0.65rem] uppercase tracking-[0.35em] text-[#c9a96e]"
  >
    Client Voices
  </p>

  <h2
    class="section-title reveal mb-6 text-center font-['Cormorant_Garamond'] text-[clamp(2.2rem,4vw,3.5rem)] font-light leading-[1.2]"
  >
    What They <em class="italic text-[#c9a96e]">Say</em>
  </h2>

  <div
    class="ornament reveal mx-auto mb-6 flex items-center justify-center gap-4"
  >
    <div
      class="h-px w-full max-w-[120px] bg-[linear-gradient(to_right,transparent,#c9a96e,transparent)]"
    >
    </div>

    <div class="h-2 w-2 shrink-0 rotate-45 bg-[#c9a96e]"></div>

    <div
      class="h-px w-full max-w-[120px] bg-[linear-gradient(to_right,transparent,#c9a96e,transparent)]"
    >
    </div>
  </div>

  <div class="testi-wrap reveal relative mx-auto mt-16 max-w-[900px]">
    <div class="overflow-hidden">
      <div
        class="flex transition-transform duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
        id="testiTrack"
      >
        {
          testimonials.map(({ addr, clientName, testimonial }) => {
            return (
              <div class="min-w-full px-8">
                <div class="relative border border-[rgba(201,169,110,0.15)] bg-[#0f0d0a] px-8 py-14 text-center md:px-14">
                  <div class="absolute left-10 top-8 font-['Cormorant_Garamond'] text-[8rem] font-light leading-[0.5] text-[rgba(201,169,110,0.12)]">
                    "
                  </div>

                  <div class="relative z-[1] mb-2 text-[0.8rem] tracking-[0.2em] text-[#c9a96e]">
                    ★ ★ ★ ★ ★
                  </div>

                  <p class="relative z-[1] mb-10 font-['Cormorant_Garamond'] text-[1.35rem] font-light italic leading-[1.8] text-[#f5f0e8]">
                    {testimonial}
                  </p>

                  <div class="flex flex-col items-center gap-1">
                    <p class="text-[0.85rem] font-medium tracking-[0.1em] text-[#c9a96e]">
                      {clientName}
                    </p>

                    <p class="text-[0.72rem] uppercase tracking-[0.15em] text-[#8a8070]">
                      {addr}
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Navigation -->
    <div class="mt-10 flex items-center justify-center gap-6">
      <button
        class="flex h-11 w-11 items-center justify-center border border-[rgba(201,169,110,0.3)] text-[1.2rem] text-[#c9a96e] transition-all duration-300 hover:border-[#c9a96e] hover:bg-[rgba(201,169,110,0.1)]"
        id="testiPrev"
      >
        &#8592;
      </button>

      <div data-dotslist class="flex gap-2">
        {
          testimonials.map((_, idx) => {
            if (idx == 0) {
              return <div class="h-[6px] w-6 bg-[#c9a96e]" data-i={`${idx}`} />;
            } else {
              return (
                <div
                  class="h-[6px] w-1.5 bg-[rgba(201,169,110,0.25)]"
                  data-i={`${idx}`}
                />
              );
            }
          })
        }
      </div>

      <button
        class="flex h-11 w-11 items-center justify-center border border-[rgba(201,169,110,0.3)] text-[1.2rem] text-[#c9a96e] transition-all duration-300 hover:border-[#c9a96e] hover:bg-[rgba(201,169,110,0.1)]"
        id="testiNext"
      >
        &#8594;
      </button>
    </div>
  </div>
</section>

<script>
  let cur = 0;

  const track = document.getElementById("testiTrack") as HTMLElement | null;
  const slides = track?.children;
  const dots = document.querySelectorAll<HTMLElement>("[data-dotslist]  div");

  if (track && slides?.length) {
    const goTo = (n: number): void => {
      cur = (n + slides.length) % slides.length;

      track.style.transform = `translateX(-${cur * 100}%)`;

      dots.forEach((dot, i) => {
        const active = i === cur;

        dot.classList.toggle("w-6", active);
        dot.classList.toggle("bg-[#c9a96e]", active);

        dot.classList.toggle("w-1.5", !active);
        dot.classList.toggle("bg-[rgba(201,169,110,0.25)]", !active);
      });
    };

    document
      .getElementById("testiPrev")
      ?.addEventListener("click", () => goTo(cur - 1));

    document
      .getElementById("testiNext")
      ?.addEventListener("click", () => goTo(cur + 1));

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(Number(dot.dataset.i));
      });
    });

    let autoSlide: ReturnType<typeof setInterval> = setInterval(() => {
      goTo(cur + 1);
    }, 6000);

    const wrapper = track.parentElement;

    wrapper?.addEventListener("mouseenter", () => {
      clearInterval(autoSlide);
    });

    wrapper?.addEventListener("mouseleave", () => {
      autoSlide = setInterval(() => {
        goTo(cur + 1);
      }, 6000);
    });
  }
</script>

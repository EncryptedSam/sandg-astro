---
import "leaflet/dist/leaflet.css";
import SectionHead from "./shared/SectionHead.astro";
---

<section id="contact" class="px-[5vw] py-28">
  <SectionHead
    tag="Reach Us"
    title={[
      { text: "Begin Your", highlight: false },
      { text: "Journey", highlight: true },
    ]}
    description="Whether you have a precise vision or simply a dream, we are here to listen. Reach out and let us begin crafting something extraordinary together."
  />

  <div class="contact-grid reveal mt-20 grid items-start gap-24 lg:grid-cols-2">
    <div>
      <div
        id="map"
        class="h-[500px] w-full border border-[rgba(201,169,110,0.15)] brightness-[0.6] contrast-110 grayscale-[80%]"
      >
      </div>
    </div>

    <div class="flex flex-col gap-10">
      <div>
        <p
          class="mb-2 flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e] after:h-px after:flex-1 after:bg-[rgba(201,169,110,0.2)] after:content-['']"
        >
          Address
        </p>

        <p
          class="font-['Cormorant_Garamond'] text-[1.2rem] leading-[1.7] text-[#f5f0e8]"
        >
          8-2-293, Road No. 78<br />
          Jubilee Hills, Hyderabad<br />
          Telangana 500 033, India
        </p>
      </div>

      <div>
        <p
          class="mb-2 flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e] after:h-px after:flex-1 after:bg-[rgba(201,169,110,0.2)] after:content-['']"
        >
          Telephone
        </p>

        <a
          href="tel:+918019961162"
          class="font-['Cormorant_Garamond'] text-[1.2rem] leading-[1.7] text-[#f5f0e8] transition-colors duration-300 hover:text-[#c9a96e]"
        >
          +91 80199 61162  
        </a>
        <br/>
        <a
          href="tel:+919966212218"
          class="font-['Cormorant_Garamond'] text-[1.2rem] leading-[1.7] text-[#f5f0e8] transition-colors duration-300 hover:text-[#c9a96e]"
        >
          +91 99662 12218
        </a>
      </div>

      <div>
        <p
          class="mb-2 flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e] after:h-px after:flex-1 after:bg-[rgba(201,169,110,0.2)] after:content-['']"
        >
          Electronic Mail
        </p>

        <a
          href="mailto:studio@SG.in"
          class="font-['Cormorant_Garamond'] text-[1.2rem] leading-[1.7] text-[#f5f0e8] transition-colors duration-300 hover:text-[#c9a96e]"
        >
          sng.constructions.interiors@gmail.com
        </a>
      </div>

      <div>
        <p
          class="mb-2 flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e] after:h-px after:flex-1 after:bg-[rgba(201,169,110,0.2)] after:content-['']"
        >
          Office Hours
        </p>

        <p
          class="font-['Cormorant_Garamond'] text-[1.2rem] leading-[1.7] text-[#f5f0e8]"
        >
          Monday - Saturday<br />
          9:00 am - 7:00 pm IST
        </p>
      </div>

      <div>
        <p
          class="mb-2 flex items-center gap-3 text-[0.65rem] uppercase tracking-[0.25em] text-[#c9a96e] after:h-px after:flex-1 after:bg-[rgba(201,169,110,0.2)] after:content-['']"
        >
          Follow Our Work
        </p>

        <div class="mt-4 flex flex-wrap gap-4">
          <a
            href="https://instagram.com/sng.constructions.interiors"
            class="border border-[rgba(201,169,110,0.2)] px-4 py-2 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070] transition-all duration-300 hover:border-[#c9a96e] hover:text-[#c9a96e]"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>

          <!-- <a
            href="#"
            class="border border-[rgba(201,169,110,0.2)] px-4 py-2 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070] transition-all duration-300 hover:border-[#c9a96e] hover:text-[#c9a96e]"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>

          <a
            href="#"
            class="border border-[rgba(201,169,110,0.2)] px-4 py-2 text-[0.65rem] uppercase tracking-[0.2em] text-[#8a8070] transition-all duration-300 hover:border-[#c9a96e] hover:text-[#c9a96e]"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pinterest
          </a> -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import L from "leaflet";

  const map = L.map("map").setView([17.385, 78.4867], 13);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors",
  }).addTo(map);

  L.marker([17.385, 78.4867])
    .addTo(map)
    .bindPopup("S&G Constructions")
    .openPopup();
</script>
